# Desarrollo en local: copia este fichero a server/.env (npm run dev y npm test lo leen solos).
# Producción: deploy/.env.example.

# PostgreSQL de compose.dev.yml (docker compose -f compose.dev.yml up -d)
DATABASE_URL=postgres://grocery:grocery@localhost:5432/grocery

# Base de datos de los tests: SE BORRA en cada pasada. Nunca la de verdad.
TEST_DATABASE_URL=postgres://grocery:grocery@localhost:5432/grocery_test

# En local se puede trabajar sin clave. En producción el servidor se niega a arrancar así.
ALLOW_NO_AUTH=1
# GROCERY_TOKEN=
