# Copy to ~/homelab/grocery/.env on the server and fill it in (chmod 600). NEVER commit it.

# --- Database -------------------------------------------------------------------
POSTGRES_VERSION=18
POSTGRES_USER=grocery
# Letters and digits only: it is embedded in a connection URL.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=grocery

# --- Access (at least one is required, or the app refuses to start) ----------------
# 1. Cloudflare Access: the app verifies the signed JWT Cloudflare adds to every request,
#    so nobody gets in by going around Access (e.g. a "Bypass" rule by mistake).
#    Team domain: Zero Trust -> Settings -> Custom pages (e.g. myteam.cloudflareaccess.com).
#    AUD: Access -> Applications -> grocery-list -> Overview -> "Application Audience (AUD) Tag".
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# 2. Shared token: for anything that calls the API without going through Cloudflare
#    (the tablet dashboard over the tunnel network, scripts). 24+ characters:
#    openssl rand -hex 24
GROCERY_TOKEN=

# --- Off-site backups (optional, see deploy/README.md) -----------------------------
# An rclone remote (ideally a "crypt" one, so the copies are encrypted), e.g. grocery-crypt:
BACKUP_RCLONE_REMOTE=

# --- Images -----------------------------------------------------------------------
# Don't set it by hand: every successful deploy writes IMAGE_TAG=<commit sha> here.
